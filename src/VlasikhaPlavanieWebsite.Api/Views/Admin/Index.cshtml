@model VlasikhaPlavanieWebsite.ViewModels.AdminParticipantsViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Участники по соревнованиям</title>
    <link rel="stylesheet" href="~/css/participants.css" asp-append-version="true" />
</head>
<body>
    <div class="participants-container">
        <h1 class="participants-title">
            Участники по соревнованиям
        </h1>
        <a href="#" id="download-button" class="download-excel-button disabled" onclick="return false;">Скачать участников для выбранного соревнования</a>

        <div class="filter-row">
            <label>
                <input type="checkbox" id="hide-finished" checked />
                Не показывать завершенные соревнования
            </label>
        </div>

        <div class="competitions-buttons" id="competitions-buttons">
            @{
                var counts = Model.Participants
                    .GroupBy(p => p.RegistrationCompetitionName)
                    .ToDictionary(g => g.Key, g => g.Select(p => new { p.LastName, p.FirstName, p.MiddleName, p.BirthDate }).Distinct().Count());
            }

            @foreach (var competition in Model.Competitions)
            {
                var count = counts.ContainsKey(competition.Name) ? counts[competition.Name] : 0;
                var isFinished = !competition.IsOpen || (competition.RegistrationEndDate.HasValue && competition.RegistrationEndDate.Value < DateTime.UtcNow);
                <button class="competition-button" data-finished="@(isFinished.ToString().ToLower())" onclick="filterBycompetition('@competition.Name')">
                    @competition.Name (@count)
                </button>
            }
        </div>

        <div class="table-responsive">
            <table class="participants-table">
                <thead>
                    <tr>
                        <th>Дата заказа</th>
                        <th>OrderId</th>
                        <th>Имя</th>
                        <th>Фамилия</th>
                        <th>Отчество</th>
                        <th>Дата рождения</th>
                        <th>Пол</th>
                        <th>Город/Команда</th>
                        <th>Разряд</th>
                        <th>Телефон</th>
                        <th>Email</th>
                        <th>Дисциплина</th>
                        <th>Дистанция</th>
                        <th>Заявочное время</th>
                    </tr>
                </thead>
                <tbody id="participants-body">
                    @foreach (var item in Model.Participants)
                    {
                        <tr data-competition="@item.RegistrationCompetitionName">
                            <td data-label="Дата заказа">@item.CreatedAt.AddHours(3).ToString("dd.MM.yyyy HH:mm")</td>
                            <td data-label="OrderId">@item.OrderId</td>
                            <td data-label="Имя">@item.FirstName</td>
                            <td data-label="Фамилия">@item.LastName</td>
                            <td data-label="Отчество">@item.MiddleName</td>
                            <td data-label="Дата рождения">@item.BirthDate.ToString("dd.MM.yyyy")</td>
                            <td data-label="Пол">@item.Gender</td>
                            <td data-label="Город/Команда">@item.CityOrTeam</td>
                            <td data-label="Разряд">@item.Rank</td>
                            <td data-label="Телефон">@item.Phone</td>
                            <td data-label="Email">@item.Email</td>
                            <td data-label="Дисциплина">@item.DisciplineName</td>
                            <td data-label="Дистанция">@item.Distance</td>
                            <td data-label="Заявочное время">@item.EntryTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script>
        var selectedcompetition = '';
        var baseDownloadUrl = '@Url.Action("DownloadParticipantsExcelBycompetition", "Admin")';
        var initialCompetition = '@(Model.SelectedCompetitionName ?? "")';

        function filterBycompetition(competition) {
            selectedcompetition = competition;
            var rows = document.querySelectorAll('#participants-body tr');
            rows.forEach(function (row) {
                if (row.getAttribute('data-competition') === competition) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            var downloadButton = document.getElementById('download-button');
            downloadButton.href = baseDownloadUrl + '?competitionName=' + encodeURIComponent(competition);
            downloadButton.classList.remove('disabled');
            downloadButton.onclick = null;
        }

        function updateCompetitionsVisibility() {
            var hideFinished = document.getElementById('hide-finished').checked;
            var buttons = document.querySelectorAll('#competitions-buttons .competition-button');

            buttons.forEach(function (btn) {
                var finished = btn.getAttribute('data-finished') === 'true';
                if (hideFinished && finished) {
                    btn.style.display = 'none';
                    if (btn.textContent.indexOf(selectedcompetition) !== -1) {
                        selectedcompetition = '';
                        document.querySelectorAll('#participants-body tr').forEach(function (r) { r.style.display = ''; });
                        var downloadButton = document.getElementById('download-button');
                        downloadButton.classList.add('disabled');
                        downloadButton.href = '#';
                        downloadButton.onclick = function () { return false; };
                    }
                } else {
                    btn.style.display = '';
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateCompetitionsVisibility();

            // Если модель передала название по умолчанию — применяем фильтр сразу
            if (initialCompetition && initialCompetition.length > 0) {
                // Ищем кнопку с таким именем (без учёта счётчика в тексте) и кликаем логически
                var buttons = document.querySelectorAll('#competitions-buttons .competition-button');
                for (var i = 0; i < buttons.length; i++) {
                    var btn = buttons[i];
                    if (btn.textContent.indexOf(initialCompetition) !== -1) {
                        filterBycompetition(initialCompetition);
                        break;
                    }
                }
            }

            document.getElementById('hide-finished').addEventListener('change', function () {
                updateCompetitionsVisibility();
            });
        });
    </script>
</body>
</html>
