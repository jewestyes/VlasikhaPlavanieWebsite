@model IEnumerable<VlasikhaPlavanieWebsite.ViewModels.ParticipantOrderViewModel>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Участники по соревнованиям</title>
    <link rel="stylesheet" href="~/css/participants.css" asp-append-version="true" />
</head>
<body>
    <div class="participants-container">
        <h1 class="participants-title">
            Участники по соревнованиям
        </h1>
        <a href="#" id="download-button" class="download-excel-button disabled" onclick="return false;">Скачать участников для выбранного соревнования</a>

        <!-- Кнопки соревнований -->
        <div class="competitions-buttons">
            @foreach (var competitionGroup in Model
            .GroupBy(p => p.RegistrationCompetitionName)
            .Select(g => new
            {
               competition = g.Key,
               UniqueParticipants = g.Select(p => new { p.LastName, p.FirstName, p.MiddleName, p.BirthDate }).Distinct().Count()
            }))
            {
                <button class="competition-button" onclick="filterBycompetition('@competitionGroup.competition')">
                    @competitionGroup.competition (@competitionGroup.UniqueParticipants)
                </button>
            }
        </div>

        <div class="table-responsive">
            <table class="participants-table">
                <thead>
                    <tr>
                        <th>Дата заказа</th>
                        <th>Имя</th>
                        <th>Фамилия</th>
                        <th>Отчество</th>
                        <th>Дата рождения</th>
                        <th>Пол</th>
                        <th>Город/Команда</th>
                        <th>Разряд</th>
                        <th>Телефон</th>
                        <th>Email</th>
                        <th>Дисциплина</th>
                        <th>Дистанция</th>
                        <th>Заявочное время</th>
                    </tr>
                </thead>
                <tbody id="participants-body">
                    @foreach (var item in Model)
                    {
                        <tr data-competition="@item.RegistrationCompetitionName">
                            <td>@item.CreatedAt.AddHours(3).ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.MiddleName</td>
                            <td>@item.BirthDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.Gender</td>
                            <td>@item.CityOrTeam</td>
                            <td>@item.Rank</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>@item.DisciplineName</td>
                            <td>@item.Distance</td>
                            <td>@item.EntryTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script>
        var selectedcompetition = '';
        var baseDownloadUrl = '@Url.Action("DownloadParticipantsExcelBycompetition", "Admin")';

        function filterBycompetition(competition) {
            selectedcompetition = competition;
            var rows = document.querySelectorAll('#participants-body tr');
            rows.forEach(function (row) {
                if (row.getAttribute('data-competition') === competition) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            // Обновление ссылки кнопки скачивания
            var downloadButton = document.getElementById('download-button');
            downloadButton.href = baseDownloadUrl + '?competitionName=' + encodeURIComponent(competition);

            // Активируем кнопку
            downloadButton.classList.remove('disabled');
            downloadButton.onclick = null;
        }
    </script>
</body>
</html>
