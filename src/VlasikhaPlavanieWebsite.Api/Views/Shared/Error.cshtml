@model VlasikhaPlavanieWebsite.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="text-danger">Упс! Что-то пошло не так...</h1>
<p>
    Мы приносим извинения за возникшие неудобства. Возникла непредвиденная ошибка при обработке запроса.
</p>

<p>
    Если ошибка повторяется, пожалуйста, напишите нам в
    <a href="https://t.me/jewestyes" target="_blank">Telegram</a> или на почту
    <a href="mailto:cool.kriss99@yandex.ru">cool.kriss99@yandex.ru</a>.
    Мы постараемся всё исправить как можно скорее.
</p>

@if (Model.ShowRequestId)
{
    <p>
        <small><strong>ID ошибки:</strong> <code>@Model.RequestId</code></small>
    </p>
}

<p>
    <a href="/" class="btn btn-primary">На главную</a>
</p>
