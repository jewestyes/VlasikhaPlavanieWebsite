@model VlasikhaPlavanieWebsite.ViewModels.PaymentViewModel

@{
	ViewData["Title"] = "Оплата";
	Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/payment.css" asp-append-version="true" />

<div class="container">
	<form class="payment-form">
		<div class="checkbox-group">
			<label><input type="checkbox" class="agreement-checkbox" required> Я принимаю условия <a asp-action="TermsOfUse" asp-controller="PaymentInfo">Пользовательского соглашения</a> и <a asp-action="Information" asp-controller="PaymentInfo">политики конфиденциальности</a></label>
			<label><input type="checkbox" class="agreement-checkbox" required> Даю согласие на обработку <a asp-action="PrivacyPolicy" asp-controller="PaymentInfo">персональных данных</a></label>
			<p id="agreement-warning" style="color: red; display: none; margin-top: 10px;">
				Поставьте галочки, чтобы продолжить оплату
			</p>
		</div>

		<div class="info-links">
			<a asp-action="Information" asp-controller="PaymentInfo">Информация о продавце</a>
			<a asp-action="RefundPolicy" asp-controller="PaymentInfo">Правила возврата</a>
			<a asp-action="PaymentPolicy" asp-controller="PaymentInfo">Правила оплаты</a>
		</div>

	</form>

