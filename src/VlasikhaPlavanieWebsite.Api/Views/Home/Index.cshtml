@model List<VlasikhaPlavanieWebsite.Models.Competition>
@{
	ViewData["Title"] = "Главная";
}

<body>
	<main>
		<meta charset="utf-8" />
		<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

		@if (Model != null && Model.Any())
		{
			<div class="competition-scroll-container">
				@foreach (var comp in Model)
				{
					<div class="competition-card">
						<h3>@comp.Name</h3>
						<p>@(comp.CompetitionStartDate?.ToString("dd MMMM yyyy") ?? "дата не указана")</p>
						<p>@comp.Address</p>
						<a asp-controller="Registration" asp-action="Index" asp-route-id="@comp.Id" class="register-button">Регистрация</a>
					</div>
				}
			</div>
		}
		else
		{
			<p style="text-align:center;">На данный момент открытых соревнований нет.</p>
		}

	</main>
</body>
