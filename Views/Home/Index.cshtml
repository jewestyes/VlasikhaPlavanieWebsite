@model Dictionary<string, (string FilePath, bool IsExternalLink)>

@{
	ViewData["Title"] = "Главная";
}

<body>
	<main>
		<div class="registration_section">
			<div class="registration">
				<h2>Регистрация на турнир</h2>
				<h3>@ViewData["StageName"]</h3>
				<p>@ViewData["CompetitionDate"] / @ViewData["CompetitionAddress"]</p>
				<a asp-controller="Registration" asp-action="Index">
					<button class="reg-button">Зарегистрироваться</button>
				</a>
			</div>

			<div id="about" class="tournament-info">
				<div class="column">
					@foreach (var key in new[] { "Положение", "Регламент", "Памятка", "Правила плавание" })
					{
						if (Model.ContainsKey(key) && !string.IsNullOrEmpty(Model[key].FilePath))
						{
							var fileData = Model[key];
							var filePath = fileData.FilePath;
							var isExternal = fileData.IsExternalLink;

							<div class="col-lg-6">
								<div class="box-item">
									<h4>
										<a target="_blank" href="@(isExternal ? filePath : Url.Content(filePath))">
											@key <i class="fas fa-download"></i>
										</a>
									</h4>
								</div>
							</div>
						}
					}
				</div>

				<div class="column">
					@if (Model.ContainsKey("Online результаты") && !string.IsNullOrEmpty(Model["Online результаты"].FilePath))
					{
						var onlineResults = Model["Online результаты"];

						<div class="col-lg-6">
							<div class="box-item">
								<h4>
									<a target="_blank" href="@onlineResults.FilePath">
										Online результаты <i class="fas fa-download"></i>
									</a>
								</h4>
							</div>
						</div>
					}

					@foreach (var key in new[] { "Первый лист", "Список судей", "Нормативы" })
					{
						if (Model.ContainsKey(key) && !string.IsNullOrEmpty(Model[key].FilePath))
						{
							var fileData = Model[key];
							var filePath = fileData.FilePath;
							var isExternal = fileData.IsExternalLink;

							<div class="col-lg-6">
								<div class="box-item">
									<h4>
										<a target="_blank" href="@(isExternal ? filePath : Url.Content(filePath))">
											@key <i class="fas fa-download"></i>
										</a>
									</h4>
								</div>
							</div>
						}
					}
				</div>

				<div class="row-info">
					@if (Model.ContainsKey("Приглашение в судейский корпус") && !string.IsNullOrEmpty(Model["Приглашение в судейский корпус"].FilePath))
					{
						var invitationLink = Model["Приглашение в судейский корпус"];

						<div class="box-item2">
							<h4>
								<a target="_blank" href="@invitationLink.FilePath">
									Приглашаем в судейский корпус 2025
								</a>
							</h4>
						</div>
					}
				</div>
			</div>


		</div>

		<div class="row">
			<div class="col-lg-3">
				<div class="service-item first-service">
					<div class="icon"></div>
					<h4>Именная заявка</h4>
					<div class="button">
						<a target="_blank" href="@(Model.ContainsKey("Именная заявка") && !string.IsNullOrEmpty(Model["Именная заявка"].FilePath)
                    ? (Model["Именная заявка"].IsExternalLink ? Model["Именная заявка"].FilePath : Url.Content(Model["Именная заявка"].FilePath))
                    : "#")">
							Ознакомиться<i class="fa fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>

			<div class="col-lg-3">
				<div class="service-item second-service">
					<div class="icon"></div>
					<h4>Заявление на перенос денежных средств</h4>
					<div class="button">
						<a target="_blank" href="@(Model.ContainsKey("Заявление на перенос денежных средств") && !string.IsNullOrEmpty(Model["Заявление на перенос денежных средств"].FilePath)
                    ? (Model["Заявление на перенос денежных средств"].IsExternalLink ? Model["Заявление на перенос денежных средств"].FilePath : Url.Content(Model["Заявление на перенос денежных средств"].FilePath))
                    : "#")">
							Ознакомиться<i class="fa fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>

			<div class="col-lg-3">
				<div class="service-item third-service">
					<div class="icon"></div>
					<h4>Видеотрансляция</h4>
					<div class="button">
						<a href="https://www.youtube.com/@@VLASIHA_KUBOK" target="_blank">
							Смотреть<i class="fa fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>

			<div class="col-lg-3">
				<div class="service-item fourth-service">
					<div class="icon"></div>
					<h4>Согласие на обработку персональных данных</h4>
					<p>До 18 лет</p>
					<div class="button">
						<a target="_blank" href="@(Model.ContainsKey("Согласие на обработку персональных данных -18") && !string.IsNullOrEmpty(Model["Согласие на обработку персональных данных -18"].FilePath)
                    ? (Model["Согласие на обработку персональных данных -18"].IsExternalLink ? Model["Согласие на обработку персональных данных -18"].FilePath : Url.Content(Model["Согласие на обработку персональных данных -18"].FilePath))
                    : "#")">
							Ознакомиться<i class="fa fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>

			<div class="col-lg-3">
				<div class="service-item fifth-service">
					<div class="icon"></div>
					<h4>Согласие на обработку персональных данных</h4>
					<p>Старше 18 лет</p>
					<div class="button">
						<a target="_blank" href="@(Model.ContainsKey("Согласие на обработку персональных данных 18+") && !string.IsNullOrEmpty(Model["Согласие на обработку персональных данных 18+"].FilePath)
                    ? (Model["Согласие на обработку персональных данных 18+"].IsExternalLink ? Model["Согласие на обработку персональных данных 18+"].FilePath : Url.Content(Model["Согласие на обработку персональных данных 18+"].FilePath))
                    : "#")">
							Ознакомиться<i class="fa fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>

			<div class="col-lg-3">
				<div class="service-item sixth-service">
					<div class="icon"></div>
					<h4>Архив протоколов</h4>
					<div class="button">
						<a target="_blank" href="https://disk.yandex.com.am/d/gEOavcMPsIVyqg">
							Ознакомиться<i class="fa fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>
		</div>



		<div class="container contacts-map-section">
			<div class="contacts">
				<h3>Контакты</h3>
				<p><i class="fas fa-phone"></i> <span class="contact-info">+7 903 599 12 90 </span><span class="contact-info"> - Игумнова Ольга Викторовна </span><br>Главный судья соревнований </p>
				<p><i class="fas fa-phone"></i> <span class="contact-info">+7 930 939 28 45 </span><span class="contact-info"> - Будяев Денис Николаевич </span><br>Главный секретарь соревнований </p>
				<p><i class="fas fa-phone"></i> <span class="contact-info">+7 925 820 71 41 </span><span class="contact-info"> - Будяева Юлия Владимировна </span><br> Организатор соревнований (по вопросам оплаты)</p>
				<p><i class="fas fa-map-marker-alt"></i> <span class="contact-info">@ViewData["CompetitionAddress"]</span></p>
				<p><i class="fas fa-envelope"></i><span class="contact-info"> plavanievlasiha@yandex.ru </span></p>
			</div>
			<div class="map-container">
				<div id="yandex-map" style="width: 100%; height: 100%;"></div>
			</div>
		</div>

		<script src="~/js/yandex-map.js" asp-append-version="true"></script>
	</main>
</body>
